        {
          "key": "unique_surahs",
          "type": "integer",
          "required": false
        },
        {
          "key": "unique_reciters",
          "type": "integer",
          "required": false
        },
        {
          "key": "updated_at",
          "type": "integer",
          "required": false
        },
        {
          "key": "daily_json",
          "type": "string",
          "size": 8192,
          "required": false,
          "default": null,
          "note": "Per-device daily series {\"<epochDay>\":{\"<devId>\":seconds}}. Must stay >= the writer cap DAILY_JSON_MAX_CHARS = 8192 (SyncEngine.android.kt), which drops oldest days until the payload is under the cap; a smaller attribute size makes real writes fail with a non-unknown-attribute error. Was 4096 until 2026-09-25."
        },
        {
          "key": "surah_plays",
          "type": "string",
          "size": 2048,
          "required": false,
          "note": "All-time per-surah play counts as a JSON object string, keys surahId 1..114 as STRINGS (JSON object keys always are), e.g. {\"1\":\"12\",\"18\":\"3\"} or {\"1\":12,\"18\":3}. Written by encodeSurahPlays (SyncEngine.android.kt) as {\"<surahId>\":<count>} with unquoted counts; decodeSurahPlays is lenient and also accepts quoted numbers, so both forms round-trip. The encoder's budget is plays.size * 12 + 2, i.e. at most ~1371 chars for all 114 surahs, so 2048 cannot be overflowed by a real write. All-time, so there is no per-device split: the pull maxes it per surah (same trade-off as daily_json). Added 2026-09-26; until provisioned the push shed this attribute via STATS_OPTIONAL_ATTRS and the per-surah chart never synced."
        }
      ],
      "indexes": [
        {
          "key": "user_idx",
          "type": "key",
          "attributes": [
            "user_id"
          ]
        }
      ]
    },
