    {
      "$id": "listening_stats",
      "name": "Listening Stats",
      "permissions": [
        "read(\"users\")",
        "create(\"users\")",
        "update(\"users\")",
        "delete(\"users\")"
      ],
      "documentSecurity": true,
      "attributes": [
        {
          "key": "user_id",
          "type": "string",
          "size": 36,
          "required": true
        },
        {
          "key": "total_seconds",
          "type": "integer",
          "required": false
        },
        {
          "key": "days_streak",
          "type": "integer",
          "required": false
        },
        {
          "key": "minutes_today",
          "type": "integer",
          "required": false
