    {
      "$id": "khatma_plans",
      "name": "Khatma Completion Plans",
      "permissions": [
        "read(\"users\")",
        "create(\"users\")",
        "update(\"users\")",
        "delete(\"users\")"
      ],
      "documentSecurity": true,
      "attributes": [
        {
          "key": "user_id",
          "type": "string",
          "size": 64,
          "required": true
        },
        {
          "key": "title",
          "type": "string",
          "size": 128,
          "required": true
        },
        {
          "key": "total_days",
          "type": "integer",
          "required": true,
          "default": 30
        },
        {
          "key": "current_surah",
          "type": "integer",
          "required": true,
          "default": 1
        },
        {
          "key": "current_ayah",
          "type": "integer",
          "required": true,
          "default": 1
        },
        {
          "key": "percent",
          "type": "float",
          "required": false,
          "default": 0.0,
          "note": "Kept because the app still writes it (progressPercentage = totalAyahsRead / 6236). Derivable from total_ayahs_read, but the push sends both and the pull falls back to it when total_ayahs_read is absent."
        },
        {
          "key": "streak",
          "type": "integer",
          "required": false,
          "note": "Consecutive-day streak (KhatmaPlan.streak). Added 2026-09-26: the pull used to FABRICATE streak 0 with startDateMs = lastProgressMs = now, so a 40-day streak became 0 on a new phone and KhatmaStore's newest-first planOrder (compareByDescending startDateMs) reshuffled."
        },
        {
          "key": "total_ayahs_read",
          "type": "integer",
          "required": false,
          "note": "Ayahs completed in this plan (KhatmaPlan.totalAyahsRead, 0..6236). The source of truth behind percent; also the direct restore value instead of the pull's round-trip through percent * 6236."
        },
        {
          "key": "start_date_ms",
          "type": "integer",
          "required": false,
          "note": "Epoch ms the plan was created (KhatmaPlan.startDateMs). Drives both daysRemaining (with last_progress_ms) and the newest-first plan ordering."
        },
        {
          "key": "last_progress_ms",
          "type": "integer",
          "required": false,
          "note": "Epoch ms of the last progress update (KhatmaPlan.lastProgressMs). Must be >= start_date_ms; daysRemaining = targetDays - (last_progress_ms - start_date_ms) / 86400000."
        }
      ],
      "indexes": [
        {
          "key": "user_khatma_idx",
          "type": "key",
          "attributes": [
            "user_id"
          ]
        }
      ]
    },
