# PostgreSQL must point to the same database as the Ghaith mobile API.
DATABASE_URL=postgres://user:password@localhost:5432/ghais
# For Heroku Postgres set this to /app/server/certs/rds-global-bundle.pem.
DATABASE_SSL_CA=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
PORT=5000
# Development only: needed if the UI and API are on different origins.
ADMIN_DEV_ORIGIN=http://localhost:5173
PUBLIC_API_URL=https://ghaith-c77c2426ed4d.herokuapp.com
# Match the ADMIN_TOKEN configured on the mobile backend for manual chart refresh.
MOBILE_API_ADMIN_TOKEN=
# Public HTTPS admin path, used for read-only image delivery.
ADMIN_PUBLIC_URL=https://ghaith-c77c2426ed4d.herokuapp.com/admin
# Create scoped R2 credentials and a bucket; never commit the values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional custom domain; without it images are served through ADMIN_PUBLIC_URL.
R2_PUBLIC_URL=
