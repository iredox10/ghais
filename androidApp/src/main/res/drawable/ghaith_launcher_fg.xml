<?xml version="1.0" encoding="utf-8"?>
<!-- No android:gravity here: with gravity the framework sizes the child by
     the vector's intrinsic 200x153dp (bigger than the inset rect), so the
     padding never took effect. Insets alone bound the drawable exactly. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ghaith_logo"
        android:top="14dp"
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp" />
</layer-list>
