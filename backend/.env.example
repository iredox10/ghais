# Postgres connection string (Render injects DATABASE_URL on the service)
DATABASE_URL=postgres://user:pass@localhost:5432/ghais

# Port listen (Render sets PORT)
PORT=8080

# Signing key for access tokens (Render: generateValue: true)
JWT_SECRET=change-me

# Google Cloud WEB client id (audience checked on Google ID-token verification)
GOOGLE_WEB_CLIENT_ID=674819710970-0daleci989c7jfgoppplppm29i8md1of.apps.googleusercontent.com
# Optional extra audiences (Android/iOS native client ids)
GOOGLE_EXTRA_CLIENT_IDS=

NODE_ENV=production
